<Window x:Class="SimpleWhisper.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SimpleWhisper.Models"
        xmlns:views="clr-namespace:SimpleWhisper.Views"
        Title="SimpleWhisper Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Loaded="OnLoaded">

    <Window.Resources>

        <!-- Value converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:AudioLevelToWidthConverter x:Key="AudioLevelToWidthConverter" />

        <!-- ════════════════════════════════════════════════════════
             Storyboard: Pulsing recording dot
             ════════════════════════════════════════════════════════ -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3"
                             Duration="0:0:0.6"
                             AutoReverse="True" />
        </Storyboard>

        <!-- ════════════════════════════════════════════════════════
             Storyboard: Spinning processing indicator
             ════════════════════════════════════════════════════════ -->
        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1" />
        </Storyboard>

        <!-- ════════════════════════════════════════════════════════
             Storyboard: Fade in
             ════════════════════════════════════════════════════════ -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetName="RootContainer"
                             Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ════════════════════════════════════════════════════════
             Storyboard: Fade out
             ════════════════════════════════════════════════════════ -->
        <Storyboard x:Key="FadeOutAnimation" Completed="OnFadeOutCompleted">
            <DoubleAnimation Storyboard.TargetName="RootContainer"
                             Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════
         Root container: the visible overlay bar
         ════════════════════════════════════════════════════════════ -->
    <Grid x:Name="RootContainer" Opacity="0">

        <!-- Drop shadow layer (behind the main bar) -->
        <Border Margin="8,4,8,8" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.5"
                                  Color="Black" />
            </Border.Effect>
        </Border>

        <!-- Main content bar -->
        <Border x:Name="MainBar"
                Margin="8,4,8,8"
                CornerRadius="8"
                Background="#CC1E1E1E"
                MinWidth="400"
                Height="40"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Status dot / spinner -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Status text -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 2: Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 3: Audio level bar / transcribed text -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ────────────────────────────────────────────────
                     Column 0: Status dot / Spinner
                     ──────────────────────────────────────────────── -->
                <Grid Grid.Column="0"
                      VerticalAlignment="Center"
                      Width="16" Height="16"
                      Margin="0,0,8,0">

                    <!-- Status indicator dot -->
                    <Ellipse x:Name="StatusDot"
                             Width="12" Height="12"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource IdleBrush}" />
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <!-- Hide dot when Processing (spinner is shown instead) -->
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:OverlayState.Processing}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <!-- Recording: red -->
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:OverlayState.Recording}">
                                        <Setter Property="Fill" Value="{StaticResource RecordingBrush}" />
                                    </DataTrigger>
                                    <!-- Done: green -->
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:OverlayState.Done}">
                                        <Setter Property="Fill" Value="{StaticResource DoneBrush}" />
                                    </DataTrigger>
                                    <!-- Error: light red -->
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:OverlayState.Error}">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Processing spinner (arc) -->
                    <Canvas Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:OverlayState.Processing}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Path Stroke="{StaticResource ProcessingBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 8,1 A 7,7 0 1 1 1,8">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation"
                                                 Angle="0"
                                                 CenterX="8"
                                                 CenterY="8" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Grid>

                <!-- ────────────────────────────────────────────────
                     Column 1: Status text
                     ──────────────────────────────────────────────── -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="White"
                           Margin="0,0,8,0" />

                <!-- ────────────────────────────────────────────────
                     Column 3: Audio level bar / Transcribed text
                     ──────────────────────────────────────────────── -->
                <Grid Grid.Column="3"
                      VerticalAlignment="Center"
                      Margin="4,0,0,0">

                    <!-- Audio level bar (during Recording) -->
                    <Border Height="6"
                            Width="100"
                            CornerRadius="3"
                            Background="#33FFFFFF"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:OverlayState.Recording}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- Filled portion -->
                        <Border CornerRadius="3"
                                Background="{StaticResource RecordingBrush}"
                                HorizontalAlignment="Left"
                                Width="{Binding AudioLevel, Converter={StaticResource AudioLevelToWidthConverter}, FallbackValue=0}" />
                    </Border>

                    <!-- Transcribed text preview (during Done) -->
                    <TextBlock Text="{Binding TranscribedText}"
                               MaxWidth="200"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#CCFFFFFF"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static models:OverlayState.Done}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
