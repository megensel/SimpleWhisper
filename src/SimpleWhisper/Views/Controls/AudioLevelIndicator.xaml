<UserControl x:Class="SimpleWhisper.Views.Controls.AudioLevelIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="16">

    <UserControl.Resources>
        <!-- Gradient from green (low) through yellow (mid) to red (high) -->
        <LinearGradientBrush x:Key="LevelGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF40A02B" Offset="0.0"/>    <!-- Green -->
            <GradientStop Color="#FF40A02B" Offset="0.35"/>   <!-- Green -->
            <GradientStop Color="#FFDF8E1D" Offset="0.60"/>   <!-- Yellow -->
            <GradientStop Color="#FFE64553" Offset="0.85"/>   <!-- Red -->
            <GradientStop Color="#FFE64553" Offset="1.0"/>    <!-- Red -->
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <!-- Background track -->
        <Border Background="#FF313244"
                CornerRadius="4"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <!-- Filled level bar -->
        <Border x:Name="LevelBar"
                Background="{StaticResource LevelGradient}"
                CornerRadius="4"
                HorizontalAlignment="Left"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="LevelScale" ScaleX="0" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.RenderTransformOrigin>
                <Point X="0" Y="0.5"/>
            </Border.RenderTransformOrigin>
        </Border>
    </Grid>
</UserControl>
