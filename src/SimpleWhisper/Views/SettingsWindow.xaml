<Window x:Class="SimpleWhisper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SimpleWhisper.Views.Controls"
        xmlns:models="clr-namespace:SimpleWhisper.Models"
        xmlns:vm="clr-namespace:SimpleWhisper.ViewModels"
        Title="SimpleWhisper Settings"
        Width="600" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E"
        Foreground="#FFCDD6F4">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- DataGrid-specific styles (need local context for bindings) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- Tab items with underline style for settings tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox and RadioButton margins for settings layout -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CatppuccinBorder}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <TabControl Background="Transparent" BorderThickness="0" Padding="0">

            <!-- ═══════════════════════════════════════════ -->
            <!--  GENERAL TAB                                -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>

                        <!-- Shortcut Section -->
                        <TextBlock Text="Shortcut" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Recording trigger" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding TriggerDisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Change..."
                                        Style="{StaticResource DarkButton}"
                                        Click="OnChangeTriggerClick"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Recording Mode Section -->
                        <TextBlock Text="Recording Mode" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <RadioButton Content="Hold to Record (push-to-talk)"
                                             IsChecked="{Binding IsRecordingHoldMode}"
                                             GroupName="RecordingMode"/>
                                <RadioButton Content="Toggle (press to start/stop)"
                                             IsChecked="{Binding IsRecordingToggleMode}"
                                             GroupName="RecordingMode"/>
                            </StackPanel>
                        </Border>

                        <!-- Options Section -->
                        <TextBlock Text="Options" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
                                <CheckBox Content="Play sound feedback" IsChecked="{Binding PlaySoundFeedback}"/>
                                <CheckBox Content="Show recording overlay" IsChecked="{Binding ShowOverlay}"/>
                            </StackPanel>
                        </Border>

                        <!-- Updates Section -->
                        <TextBlock Text="Updates" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Automatically check for updates"
                                          IsChecked="{Binding AutoCheckForUpdates}"/>
                                <TextBlock Text="Checks GitHub for new releases on startup and every 4 hours"
                                           Style="{StaticResource FieldLabel}" FontSize="11"
                                           Margin="0,0,0,8"/>
                                <Button x:Name="CheckForUpdatesButton"
                                        Content="Check Now"
                                        Style="{StaticResource DarkButton}"
                                        Click="OnCheckForUpdatesClick"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!--  AUDIO TAB                                  -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>

                        <!-- Microphone Section -->
                        <TextBlock Text="Microphone" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Input device" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedIndex="{Binding SelectedDeviceIndex}"
                                          Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1" Content="Test Microphone"
                                            Style="{StaticResource DarkButton}"
                                            Click="OnTestMicrophoneClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Audio Level Section -->
                        <TextBlock Text="Audio Level" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Microphone input level" Style="{StaticResource FieldLabel}"/>
                                <controls:AudioLevelIndicator x:Name="AudioLevel"
                                                               Height="20"
                                                               Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Output Volume Section -->
                        <TextBlock Text="Output Volume" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Reduce system volume while recording"
                                          IsChecked="{Binding ReduceOutputVolumeWhileRecording}"/>
                                <TextBlock Text="Lowers playback volume to prevent audio bleed into the microphone"
                                           Style="{StaticResource FieldLabel}" FontSize="11"
                                           Margin="0,0,0,8"/>

                                <StackPanel Margin="20,0,0,0"
                                            IsEnabled="{Binding ReduceOutputVolumeWhileRecording}">
                                    <CheckBox Content="Mute output completely"
                                              IsChecked="{Binding MuteOutputWhileRecording}"
                                              Margin="0,0,0,6"/>

                                    <StackPanel IsEnabled="{Binding MuteOutputWhileRecording,
                                                Converter={x:Static controls:InverseBooleanConverter.Instance}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Volume reduction" Style="{StaticResource FieldLabel}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding OutputVolumeReductionPercent, StringFormat='{}{0}%'}"/>
                                        </Grid>
                                        <Slider Style="{StaticResource DarkSlider}"
                                                Minimum="10" Maximum="100"
                                                Value="{Binding OutputVolumeReductionPercent}"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                Margin="0,4,0,0"/>
                                        <TextBlock Text="How much to reduce (e.g. 80% = output at 20% of normal)"
                                                   Style="{StaticResource FieldLabel}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!--  TRANSCRIPTION TAB                          -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem Header="Transcription">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>

                        <!-- Engine Section -->
                        <TextBlock Text="Engine" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Transcription engine" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding EngineOptions}"
                                          SelectedValue="{Binding SelectedEngine, Mode=TwoWay}"
                                          SelectedValuePath="Engine"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource DarkComboBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- OpenAI Settings -->
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding IsOpenAIEngine, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="OpenAI Settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <TextBlock Text="OpenAI API Key" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="OpenAIApiKeyBox"
                                             Style="{StaticResource DarkPasswordBox}"
                                             PasswordChanged="OnOpenAIApiKeyChanged"
                                             MaxLength="200"
                                             Margin="0,0,0,8"/>
                                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding OpenAIModels}"
                                          SelectedValue="{Binding OpenAIModel, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource DarkComboBox}"
                                          Margin="0,0,0,8"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://platform.openai.com/api-keys"
                                               RequestNavigate="OnHyperlinkRequestNavigate"
                                               Foreground="{StaticResource AccentBrush}">
                                        Get an API key from OpenAI
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Gemini Settings -->
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding IsGeminiEngine, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Google Gemini Settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <TextBlock Text="Gemini API Key" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="GeminiApiKeyBox"
                                             Style="{StaticResource DarkPasswordBox}"
                                             PasswordChanged="OnGeminiApiKeyChanged"
                                             MaxLength="200"
                                             Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding GeminiModelDisplayName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://aistudio.google.com/apikey"
                                               RequestNavigate="OnHyperlinkRequestNavigate"
                                               Foreground="{StaticResource AccentBrush}">
                                        Get an API key from Google AI Studio
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Groq Settings -->
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding IsGroqEngine, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Groq Settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <TextBlock Text="Groq API Key" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="GroqApiKeyBox"
                                             Style="{StaticResource DarkPasswordBox}"
                                             PasswordChanged="OnGroqApiKeyChanged"
                                             MaxLength="200"
                                             Margin="0,0,0,8"/>
                                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding GroqModels}"
                                          SelectedValue="{Binding GroqModel, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource DarkComboBox}"
                                          Margin="0,0,0,8"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://console.groq.com/keys"
                                               RequestNavigate="OnHyperlinkRequestNavigate"
                                               Foreground="{StaticResource AccentBrush}">
                                        Get an API key from Groq
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Deepgram Settings -->
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding IsDeepgramEngine, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Deepgram Settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <TextBlock Text="Deepgram API Key" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="DeepgramApiKeyBox"
                                             Style="{StaticResource DarkPasswordBox}"
                                             PasswordChanged="OnDeepgramApiKeyChanged"
                                             MaxLength="200"
                                             Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding DeepgramModelDisplayName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBlock Text="Auto-detect language adds several seconds on Deepgram; set a language for fastest results."
                                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,0,0,8"/>
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://console.deepgram.com/"
                                               RequestNavigate="OnHyperlinkRequestNavigate"
                                               Foreground="{StaticResource AccentBrush}">
                                        Get an API key from Deepgram
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Local Settings -->
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding IsLocalEngine, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Local Settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <TextBlock Text="Model Size" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableModelSizes}"
                                          SelectedItem="{Binding LocalModelSize}"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Use .en models for faster English-only transcription"
                                           Style="{StaticResource FieldLabel}" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Hardware Acceleration" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableGpuOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding GpuAcceleration}"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="Auto-detect tries GPU first, then falls back to CPU"
                                           Style="{StaticResource FieldLabel}" FontSize="11"
                                           Margin="0,0,0,8"/>

                                <CheckBox Content="Trim silence from recording"
                                          IsChecked="{Binding TrimSilence}"
                                          Margin="0,4,0,2"/>
                                <TextBlock Text="Removes leading/trailing silence for faster processing"
                                           Style="{StaticResource FieldLabel}" FontSize="11"
                                           Margin="0,0,0,8"/>

                                <CheckBox Content="Real-time transcription"
                                          IsChecked="{Binding RealtimeTranscription}"
                                          Margin="0,4,0,2"/>
                                <TextBlock Text="Show transcription as you speak (local engine only)"
                                           Style="{StaticResource FieldLabel}" FontSize="11"
                                           Margin="0,0,0,8"/>

                                <Button Content="Download Model"
                                        Style="{StaticResource DarkButton}"
                                        Click="OnDownloadModelClick"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"/>
                                <ProgressBar x:Name="ModelDownloadProgress"
                                             Height="6"
                                             Minimum="0" Maximum="100" Value="0"
                                             Background="{StaticResource SurfaceBg}"
                                             Foreground="{StaticResource AccentBrush}"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Language Section -->
                        <TextBlock Text="Language" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Auto-detect language"
                                          IsChecked="{Binding AutoDetectLanguage}"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="Language" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SelectedLanguage}"
                                          IsEnabled="{Binding AutoDetectLanguage, Converter={x:Static controls:InverseBooleanConverter.Instance}}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!--  TEXT PROCESSING TAB                         -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem Header="Text Processing">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>

                        <!-- Options -->
                        <TextBlock Text="Processing Options" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Enable spoken punctuation (e.g. &quot;period&quot; becomes &quot;.&quot;)"
                                          IsChecked="{Binding SpokenPunctuationEnabled}"/>
                                <CheckBox Content="Enable emoji insertion (e.g. &quot;smiley face&quot; becomes the emoji)"
                                          IsChecked="{Binding EmojiInsertionEnabled}"/>
                            </StackPanel>
                        </Border>

                        <!-- Custom Vocabulary -->
                        <TextBlock Text="Custom Vocabulary" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Add words or phrases to improve recognition (one per line)"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding CustomVocabularyText, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="80"/>
                            </StackPanel>
                        </Border>

                        <!-- Text Replacements -->
                        <TextBlock Text="Text Replacements" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <DataGrid x:Name="ReplacementsGrid"
                                          ItemsSource="{Binding TextReplacements}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          Background="{StaticResource SurfaceBg}"
                                          Foreground="{StaticResource TextPrimary}"
                                          BorderBrush="{StaticResource CatppuccinBorder}"
                                          RowBackground="{StaticResource SurfaceBg}"
                                          AlternatingRowBackground="#FF3B3D50"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource CatppuccinBorder}"
                                          HeadersVisibility="Column"
                                          MaxHeight="180"
                                          CellEditEnding="OnReplacementCellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Find" Binding="{Binding Find}" Width="*" MinWidth="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Replace" Binding="{Binding Replace}" Width="*" MinWidth="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridComboBoxColumn Header="Type"
                                                                SelectedItemBinding="{Binding Type}"
                                                                Width="110">
                                            <DataGridComboBoxColumn.ElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
                                                </Style>
                                            </DataGridComboBoxColumn.ElementStyle>
                                            <DataGridComboBoxColumn.EditingElementStyle>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
                                                </Style>
                                            </DataGridComboBoxColumn.EditingElementStyle>
                                        </DataGridComboBoxColumn>
                                        <DataGridCheckBoxColumn Header="Enabled"
                                                                Binding="{Binding IsEnabled}"
                                                                Width="65"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                    <Button Content="Add Rule"
                                            Style="{StaticResource DarkButton}"
                                            Command="{Binding AddReplacementCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Remove"
                                            Style="{StaticResource DarkButton}"
                                            Command="{Binding RemoveReplacementCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=ReplacementsGrid}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
